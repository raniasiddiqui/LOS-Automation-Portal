# Copy to .env and fill in the blanks. .env is gitignored — never commit it.

# --- Target environment (QA) -------------------------------------------
QA_BASE_URL=
QA_LOGIN_URL=

# --- Credentials -------------------------------------------------------
QA_USERNAME=
QA_PASSWORD=

# --- Login form selectors ----------------------------------------------
QA_LOGIN_USER_SELECTOR=input[formcontrolname="username"]
QA_LOGIN_PASS_SELECTOR=input[formcontrolname="password"]
QA_LOGIN_SUBMIT_SELECTOR=button[type="submit"]

# --- Crawler limits ----------------------------------------------------
QA_MAX_PAGES=5
QA_MAX_RECURSION_DEPTH=3
QA_MAX_DEEP_STATES=10

# --- LLM ---------------------------------------------------------------
GROQ_API_KEY=

# --- Browser -----------------------------------------------------------
QA_HEADLESS=false

# Hosts authored flows may WRITE to. Both are dev.
#
# The second one is not obvious and is easy to delete by mistake: PR Checklist's
# "Perform PR" opens the RiskRating app in a NEW TAB on a different machine
# (.../NationalBankInternal-RiskRating-Dev/.../pgPRNew.aspx), and the whole PR
# checklist — every factor, Generate, Save — happens over there. Without this
# entry the PR flow refuses to type anything, which is the gate working
# correctly rather than a bug.
LOS_ALLOWED_WRITE_HOSTS=

# --- Inputs ------------------------------------------------------------
# Absolute path to the FSD document used for test-case generation.
QA_FSD_FILE=
